FEISHU_APP_ID=
FEISHU_APP_SECRET=
PORT=3001
HOST=0.0.0.0
CONFIG_PATH=./data/config.json
STATS_PATH=./data/stats.json
PORTFOLIO_DB_PATH=./data/portfolio-db.json

# Optional. If set, /api/* requires this token in the admin UI.
# ADMIN_TOKEN=change-this-token

# Optional but recommended after you enable them in Feishu event subscription.
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.5
MODEL_API_KEY=
MODEL_WIRE_API=responses
# Supported: minimal, low, medium, high, xhigh
MODEL_REASONING_EFFORT=high
MODEL_MAX_OUTPUT_TOKENS=9600
MODEL_RESPONSES_STREAM=true
# 0 means no timeout for model requests. Long extra-high reasoning can exceed several minutes.
MODEL_HTTP_TIMEOUT_MS=0
FEISHU_REPLY_MAX_CHARS=18000
FEISHU_USE_CARDS=true
FEISHU_PORTFOLIO_TREND_IMAGES=true
FEISHU_PORTFOLIO_TREND_IMAGE_LIMIT=3
FEISHU_REPORT_TREND_IMAGES=true
FEISHU_REPORT_TREND_IMAGE_LIMIT=10
FEISHU_REPORT_TREND_IMAGE_MIN=6
# summary = trend + drawdown + stage-return chart; trend = legacy line chart only.
FEISHU_REPORT_CHART_MODE=summary
# 2 means render charts at 2x pixels while keeping the same visual layout in Feishu.
FEISHU_REPORT_CHART_PIXEL_RATIO=2
FUND_ANSWER_QUALITY_GATE=true
FUND_ANSWER_QUALITY_REWRITE=true
HTTP_TIMEOUT_MS=120000
HTTP_POST_TIMEOUT_MS=120000
PUBLIC_DATA_TIMEOUT_MS=20000
MARKET_FAST_NEWS_LIMIT=30
RISK_FREE_RATE_PCT=2
FUND_NAV_MAX_PAGES=35
# Optional precious-metal market snapshot settings.
# Defaults include COMEX gold/silver, SHFE gold/silver main contracts, and USD index.
PRECIOUS_METAL_SECIDS=101.GC00Y,113.aum,101.SI00Y,113.agm,100.UDI
PRECIOUS_METAL_FUND_KEYWORDS=黄金,贵金属,白银
PRECIOUS_METAL_FUND_LIMIT=12
FUND_DISCOVERY_RANK_LIMIT=24
PULLBACK_SETUP_KEYWORD_LIMIT=24
PULLBACK_SETUP_RANK_LIMIT=60
PULLBACK_SETUP_REVERSAL_LIMIT=72
PULLBACK_SETUP_SEED_LIMIT=80
MARKET_DEEP_DIVE_FUND_LIMIT=16
# Used when the user asks for generic "回调完成/低位启动" candidates without naming a sector.
PULLBACK_SETUP_FUND_KEYWORDS=沪深300,中证500,中证1000,创业板,科创50,红利,医药,消费,新能源,军工,港股,半导体

# Virtual fund manager. You can also set these in /admin.
PORTFOLIO_ENABLED=false
PORTFOLIO_INITIAL_CAPITAL=100000
PORTFOLIO_PREMARKET_TIME=09:00
PORTFOLIO_DECISION_TIME=14:20
PORTFOLIO_REVIEW_TIME=21:30
PORTFOLIO_WEEKLY_REVIEW_TIME=16:30
# 0=Sunday, 1=Monday, ..., 5=Friday, 6=Saturday
PORTFOLIO_WEEKLY_REVIEW_DAY=5
PORTFOLIO_TIMEZONE=Asia/Shanghai
PORTFOLIO_RETENTION_DAYS=90
# Running portfolio jobs older than this without progress are marked interrupted.
PORTFOLIO_RUN_STALE_MINUTES=180
# Keep admin pages responsive while long portfolio tasks are running.
PORTFOLIO_DB_FLUSH_DELAY_MS=1000
PORTFOLIO_PROGRESS_FLUSH_MS=5000
PORTFOLIO_DB_MAX_RUNS=120
PORTFOLIO_DB_MAX_LIST_ITEMS=300
EVENT_LOOP_LAG_WARN_MS=3000
PORTFOLIO_AUTO_BIND_LAST_CHAT=true
PORTFOLIO_PUSH_RECEIVE_TYPE=chat_id
# Leave empty to auto-bind the latest chat_id after you send the bot a message.
PORTFOLIO_PUSH_RECEIVE_ID=
PORTFOLIO_RISK_PROFILE=balanced
# Optional one-line manager profile. For longer text, configure it in /admin.
PORTFOLIO_MANAGER_PROFILE=

# Used only by docker-compose.pull.yml after a registry image has been published.
DOCKER_IMAGE=ghcr.io/1104431512/fundagent:latest
