FEISHU_APP_ID=
FEISHU_APP_SECRET=
PORT=3001
HOST=0.0.0.0
CONFIG_PATH=./data/config.json
STATS_PATH=./data/stats.json

# Optional. If set, /api/* requires this token in the admin UI.
# ADMIN_TOKEN=change-this-token

# Optional but recommended after you enable them in Feishu event subscription.
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.5
MODEL_API_KEY=
MODEL_WIRE_API=responses
MODEL_REASONING_EFFORT=high
MODEL_MAX_OUTPUT_TOKENS=1800
FEISHU_REPLY_MAX_CHARS=6000
RISK_FREE_RATE_PCT=2
FUND_NAV_MAX_PAGES=35

FUND_SCREENING_SKILL_PATH=./skills/fund-screening.md

# Used only by docker-compose.pull.yml after a registry image has been published.
DOCKER_IMAGE=ghcr.io/1104431512/fundagent:latest
